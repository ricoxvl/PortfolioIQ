# Local development only. Copy to .env and provide your own secrets when needed.
DATABASE_URL=sqlite:///./portfolioiq_v4.sqlite3
DEPLOYMENT_MODE=local
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# For public production, set DEPLOYMENT_MODE=production, PostgreSQL, HTTPS,
# COOKIE_SECURE=true, explicit TRUSTED_HOSTS and a random 32+ character secret.
# AUTH_RATE_LIMIT_SECRET=replace-with-unique-random-32-plus-character-secret
# OPENAI_API_KEY=your-own-secret
# OPENAI_MODEL=gpt-4.1-mini


# v0.8 market research: disabled by default. DO NOT add API keys to Git.
MARKET_DATA_ENABLED=false
# TWELVE_DATA_API_KEY=YOUR_PRIVATE_KEY_IN_LOCAL_ENV_ONLY
# For a publicly displayed service this is permitted ONLY with written display rights:
MARKET_DATA_EXTERNAL_DISPLAY_LICENSE=false